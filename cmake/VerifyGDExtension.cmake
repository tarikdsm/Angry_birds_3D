foreach(_required IN ITEMS DLL_PATH STAMP_PATH EXPECTED_TOKEN EXPECTED_CONFIG
    EXPECTED_TARGET EXPECTED_DLL_NAME DESCRIPTOR_PATH DUMPBIN_EXECUTABLE)
  if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
    message(FATAL_ERROR "Missing ${_required} for GDExtension verification")
  endif()
endforeach()
if(NOT EXISTS "${DLL_PATH}")
  message(FATAL_ERROR "Expected GDExtension DLL does not exist: ${DLL_PATH}")
endif()
if(NOT EXISTS "${STAMP_PATH}")
  message(FATAL_ERROR "Current-config GDExtension build stamp does not exist: ${STAMP_PATH}")
endif()

file(STRINGS "${STAMP_PATH}" _stamp_lines)
foreach(_field IN ITEMS TOKEN CONFIG TARGET DLL_PATH DLL_NAME SHA256)
  set(_stamp_${_field} "")
  foreach(_line IN LISTS _stamp_lines)
    if(_line MATCHES "^${_field}=(.*)$")
      set(_stamp_${_field} "${CMAKE_MATCH_1}")
      break()
    endif()
  endforeach()
  if("${_stamp_${_field}}" STREQUAL "")
    message(FATAL_ERROR "GDExtension build stamp is missing ${_field}: ${STAMP_PATH}")
  endif()
endforeach()

if(NOT "${_stamp_TOKEN}" STREQUAL "${EXPECTED_TOKEN}")
  message(FATAL_ERROR "Stale GDExtension DLL: configure token does not match the latest build")
endif()
if(NOT "${_stamp_CONFIG}" STREQUAL "${EXPECTED_CONFIG}")
  message(FATAL_ERROR "GDExtension stamp config mismatch: ${_stamp_CONFIG} != ${EXPECTED_CONFIG}")
endif()
if(NOT "${_stamp_TARGET}" STREQUAL "${EXPECTED_TARGET}")
  message(FATAL_ERROR "GDExtension stamp target mismatch: ${_stamp_TARGET} != ${EXPECTED_TARGET}")
endif()
file(TO_CMAKE_PATH "${DLL_PATH}" _expected_dll_path)
if(NOT "${_stamp_DLL_PATH}" STREQUAL "${_expected_dll_path}")
  message(FATAL_ERROR "GDExtension stamp path mismatch: ${_stamp_DLL_PATH} != ${_expected_dll_path}")
endif()
if(NOT "${_stamp_DLL_NAME}" STREQUAL "${EXPECTED_DLL_NAME}")
  message(FATAL_ERROR "GDExtension stamp DLL mismatch: ${_stamp_DLL_NAME} != ${EXPECTED_DLL_NAME}")
endif()

file(SHA256 "${DLL_PATH}" _actual_sha256)
if(NOT "${_stamp_SHA256}" STREQUAL "${_actual_sha256}")
  message(FATAL_ERROR "GDExtension DLL hash does not match its current build stamp")
endif()

file(READ "${DESCRIPTOR_PATH}" _descriptor)
if(NOT _descriptor MATCHES "entry_symbol[ \\t]*=[ \\t]*\"ninho_physics_library_init\"")
  message(FATAL_ERROR "GDExtension descriptor entry_symbol does not match the export")
endif()
if(EXPECTED_TARGET STREQUAL "template_debug" AND NOT EXPECTED_CONFIG STREQUAL "Debug")
  message(FATAL_ERROR "Debug GDExtension target requires Debug config, got ${EXPECTED_CONFIG}")
elseif(EXPECTED_TARGET STREQUAL "template_release" AND NOT EXPECTED_CONFIG STREQUAL "Release")
  message(FATAL_ERROR "Release GDExtension target requires Release config, got ${EXPECTED_CONFIG}")
endif()
if(EXPECTED_TARGET STREQUAL "template_debug")
  set(_descriptor_key "windows.debug.x86_64")
elseif(EXPECTED_TARGET STREQUAL "template_release")
  set(_descriptor_key "windows.release.x86_64")
else()
  message(FATAL_ERROR "Unsupported GODOTCPP_TARGET in GDExtension probe: ${EXPECTED_TARGET}")
endif()
set(_descriptor_library "res://bin/${EXPECTED_DLL_NAME}")
string(FIND "${_descriptor}" "${_descriptor_key} = \"${_descriptor_library}\"" _descriptor_match)
if(_descriptor_match EQUAL -1)
  message(FATAL_ERROR "GDExtension descriptor does not map ${_descriptor_key} to ${_descriptor_library}")
endif()

execute_process(
  COMMAND "${DUMPBIN_EXECUTABLE}" /exports "${DLL_PATH}"
  RESULT_VARIABLE _dumpbin_result
  OUTPUT_VARIABLE _dumpbin_output
  ERROR_VARIABLE _dumpbin_error
)
if(NOT _dumpbin_result EQUAL 0)
  message(FATAL_ERROR "dumpbin failed for ${DLL_PATH}: ${_dumpbin_error}")
endif()
if(NOT _dumpbin_output MATCHES "ninho_physics_library_init")
  message(FATAL_ERROR "GDExtension entry symbol is missing from ${DLL_PATH}")
endif()
